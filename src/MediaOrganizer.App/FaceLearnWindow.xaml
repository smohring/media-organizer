<Window x:Class="MediaOrganizer.App.FaceLearnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Learn.Title}"
        Width="820" Height="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{DynamicResource S.Learn.Heading}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="{DynamicResource S.Learn.Intro}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="FolderBox" VerticalAlignment="Center" />
            <Button Grid.Column="1" Margin="6,0,0,0" Content="{DynamicResource S.Learn.ChooseFolder}" Click="Browse_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ClustersHost">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="12" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Thumbs}" Margin="0,0,14,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="72" Height="72" Margin="0,0,4,0"
                                                        CornerRadius="6" ClipToBounds="True">
                                                    <Image Source="{Binding}" Stretch="UniformToFill" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding CountText}" />
                                        <ComboBox Margin="0,4,0,0" IsEditable="True"
                                                  ItemsSource="{Binding KnownNames}"
                                                  Text="{Binding AssignedName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   Text="{Binding HintText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="BusyPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <ProgressBar x:Name="ScanProgress" Height="5" Maximum="1" />
                <TextBlock x:Name="ScanStatus" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="ResultText" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ScanButton" Content="{DynamicResource S.Learn.Scan}" MinWidth="150" Margin="0,0,8,0"
                        Click="Scan_Click" />
                <Button Content="{DynamicResource S.Learn.Close}" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="{DynamicResource S.Learn.SaveNames}" MinWidth="140" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

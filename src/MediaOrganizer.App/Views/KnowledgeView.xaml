<UserControl x:Class="MediaOrganizer.App.Views.KnowledgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaOrganizer.App.ViewModels"
             xmlns:conv="clr-namespace:MediaOrganizer.App.Converters">
    <UserControl.Resources>
        <conv:ObjectToVisibilityConverter x:Key="VisibleIfNotNull" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="CollapsedIfTrue" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{DynamicResource S.KV.Title}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="{DynamicResource S.KV.Intro}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Personen -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                           Text="{DynamicResource S.KV.PeopleTitle}" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="{DynamicResource S.KV.PeopleIntro}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Margin="0,0,8,0" Content="{DynamicResource S.KV.LearnFromFolder}"
                                        ToolTip="{DynamicResource S.KV.LearnFromFolderTip}"
                                        Click="LearnFromFolder_Click" />
                                <Button Content="{DynamicResource S.KV.AddPerson}" Click="AddPerson_Click" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding People}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PersonViewModel}">
                                    <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                        MouseLeftButtonDown="Person_MouseLeftButtonDown"
                                                        Background="Transparent"
                                                        ToolTip="{DynamicResource S.KV.DoubleClickToEdit}">
                                                <TextBlock FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                                            </StackPanel>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Faces}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FaceThumbViewModel}">
                                                        <Border Width="64" Height="64" Margin="0,0,6,6"
                                                                CornerRadius="6" ClipToBounds="True"
                                                                ToolTip="{DynamicResource S.KV.FaceTip}"
                                                                ContextMenuOpening="FaceThumb_ContextMenuOpening"
                                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                            <Border.ContextMenu>
                                                                <ContextMenu />
                                                            </Border.ContextMenu>
                                                            <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource SubtleIconButton}" Margin="0,0,4,0"
                                                        Content="&#xE70F;" ToolTip="{DynamicResource S.KV.EditPersonTip}"
                                                        Click="EditPerson_Click" />
                                                <Button Style="{StaticResource SubtleIconButton}"
                                                        Content="&#xE74D;" ToolTip="{DynamicResource S.KV.DeletePersonTip}"
                                                        Command="{Binding DataContext.RemovePersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Caption}"
                                   Visibility="{Binding HasPeople, Converter={StaticResource CollapsedIfTrue}}"
                                   Text="{DynamicResource S.KV.NoPeople}" />
                    </StackPanel>
                </Border>

                <!-- Fakten -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="{DynamicResource S.KV.FactsTitle}" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="{DynamicResource S.KV.FactsIntro}" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Top"
                                    Content="{DynamicResource S.KV.AddFact}" Click="AddFact_Click" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Facts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Background="Transparent"
                                                   ToolTip="{DynamicResource S.KV.DoubleClickToEdit}"
                                                   MouseLeftButtonDown="Fact_MouseLeftButtonDown"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding}" />
                                        <Button Grid.Column="1" Style="{StaticResource SubtleIconButton}" Margin="0,0,4,0"
                                                Content="&#xE70F;" ToolTip="{DynamicResource S.KV.EditFactTip}"
                                                Click="EditFact_Click" />
                                        <Button Grid.Column="2" Style="{StaticResource SubtleIconButton}"
                                                Content="&#xE74D;" ToolTip="{DynamicResource S.KV.RemoveFactTip}"
                                                Command="{Binding DataContext.RemoveFactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Caption}"
                                   Visibility="{Binding HasFacts, Converter={StaticResource CollapsedIfTrue}}"
                                   Text="{DynamicResource S.KV.NoFacts}" />
                    </StackPanel>
                </Border>

                <!-- Heimatzonen -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="{DynamicResource S.KV.ZonesTitle}" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="{DynamicResource S.KV.ZonesIntro}" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Top"
                                    Content="{DynamicResource S.KV.AddZone}" Click="AddZone_Click" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding HomeZones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HomeZoneViewModel}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Glyph}"
                                                   FontSize="14" Margin="0,0,10,0" Text="&#xE80F;" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    ToolTip="{DynamicResource S.KV.ClickToEdit}"
                                                    MouseLeftButtonDown="Zone_MouseLeftButtonDown">
                                            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Style="{StaticResource SubtleIconButton}" Margin="0,0,4,0"
                                                    Content="&#xE70F;" ToolTip="{DynamicResource S.KV.EditZoneTip}"
                                                    Click="EditZone_Click" />
                                            <Button Style="{StaticResource SubtleIconButton}"
                                                    Content="&#xE74D;" ToolTip="{DynamicResource S.KV.RemoveZoneTip}"
                                                    Command="{Binding DataContext.RemoveHomeZoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Caption}"
                                   Visibility="{Binding HasHomeZones, Converter={StaticResource CollapsedIfTrue}}"
                                   Text="{DynamicResource S.KV.NoZones}" />
                    </StackPanel>
                </Border>

                <!-- Notizen -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="{DynamicResource S.KV.NotesTitle}" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="{DynamicResource S.KV.NotesIntro}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="{DynamicResource S.KV.Redistill}" Margin="0,0,8,0"
                                        ToolTip="{DynamicResource S.KV.RedistillTip}"
                                        Command="{Binding RedistillNotesCommand}" />
                                <Button Content="{DynamicResource S.KV.RemoveAll}"
                                        ToolTip="{DynamicResource S.KV.RemoveAllTip}"
                                        Command="{Binding RemoveAllNotesCommand}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Notes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NoteViewModel}">
                                    <Border Width="210" Margin="0,0,10,10" Padding="10" CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            ToolTip="{Binding Note}"
                                            MouseLeftButtonDown="Note_MouseLeftButtonDown"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Border.ContextMenu>
                                            <!-- Das Kontextmenü hängt nicht im Visual Tree der Ansicht;
                                                 der Weg zum ViewModel führt über PlacementTarget.Tag. -->
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource S.KV.RemoveNote}"
                                                          Command="{Binding PlacementTarget.Tag.RemoveNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel>
                                            <Border Height="120" CornerRadius="4" ClipToBounds="True"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <Grid>
                                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="24"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="&#xEB9F;"
                                                               Visibility="{Binding Preview, Converter={StaticResource VisibleIfNotNull}, ConverterParameter=invert}" />
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding FileName}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Caption}"
                                   Visibility="{Binding HasNotes, Converter={StaticResource CollapsedIfTrue}}"
                                   Text="{DynamicResource S.KV.NoNotes}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource Caption}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource VisibleIfNotNull}}"
                   Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>

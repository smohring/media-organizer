<Window x:Class="MediaOrganizer.App.FaceAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Assign.Title}"
        Width="720" Height="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{DynamicResource S.Assign.Title}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                <ItemsControl x:Name="FacesHost">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="12" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="96" Height="96" CornerRadius="6"
                                            ClipToBounds="True" Margin="0,0,14,0">
                                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Assign.PersonName}" />
                                        <ComboBox IsEditable="True"
                                                  ItemsSource="{Binding KnownNames}"
                                                  Text="{Binding AssignedName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                   Text="{Binding SuggestionText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Style="{StaticResource Caption}"
                                               Text="{Binding ScoreText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource S.Cancel}" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="{DynamicResource S.Assign.Save}" MinWidth="150"
                    Style="{DynamicResource AccentButtonStyle}"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>

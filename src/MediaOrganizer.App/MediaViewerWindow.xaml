<Window x:Class="MediaOrganizer.App.MediaViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Viewer.Title}"
        Width="1100" Height="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Medienfläche -->
        <Grid Grid.Row="0" Background="#101010">
            <Image x:Name="PhotoView" Stretch="Uniform" Margin="8" />
            <MediaElement x:Name="VideoView"
                          Stretch="Uniform" Margin="8"
                          LoadedBehavior="Manual" UnloadedBehavior="Stop"
                          Visibility="Collapsed"
                          MediaOpened="VideoView_MediaOpened"
                          MediaFailed="VideoView_MediaFailed"
                          MediaEnded="VideoView_MediaEnded" />

            <!-- Wiedergabe über ffmpeg, wenn MediaElement den Codec nicht kann -->
            <Image x:Name="PlayerView" Stretch="Uniform" Margin="8"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   Visibility="Collapsed" />

            <TextBlock x:Name="MediaErrorText"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="520" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Visibility="Collapsed" />

            <!-- Navigationsflächen -->
            <Button x:Name="PrevButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="16" Width="48" Height="48"
                    FontFamily="Segoe Fluent Icons" FontSize="18" Content="&#xE76B;"
                    ToolTip="{DynamicResource S.Viewer.Previous}"
                    Click="Prev_Click" />
            <Button x:Name="NextButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="16" Width="48" Height="48"
                    FontFamily="Segoe Fluent Icons" FontSize="18" Content="&#xE76C;"
                    ToolTip="{DynamicResource S.Viewer.Next}"
                    Click="Next_Click" />
        </Grid>

        <!-- Infoleiste -->
        <Border Grid.Row="1" Padding="16,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="DescriptionText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CodecText" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" />
                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="PlayPause_Click"
                            Content="&#xE769;" ToolTip="{DynamicResource S.Viewer.Pause}" />

                    <!-- Ton nur dort, wo es welchen gibt: Der ffmpeg-Spieler
                         läuft ohne Tonspur, dann bleibt die Gruppe weg. -->
                    <StackPanel x:Name="VolumePanel" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Margin="0,0,4,0"
                                Click="Mute_Click"
                                Content="&#xE767;" ToolTip="{DynamicResource S.Viewer.Mute}" />
                        <Slider x:Name="VolumeSlider" Width="90" VerticalAlignment="Center"
                                Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2"
                                ToolTip="{DynamicResource S.Viewer.Volume}"
                                ValueChanged="Volume_ValueChanged" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="CounterText" Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The profile used to produce a shippable build:

      dotnet publish src\MediaOrganizer.App -p:PublishProfile=win-x64

  It lives in a profile rather than in the .csproj so that a plain
  `dotnet build` stays fast and framework-dependent during development.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\..\artifacts\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- The package carries the .NET 10 runtime. A fresh Windows machine then
         needs no separate runtime download, and no other application can break
         this one by replacing a shared runtime underneath it. Costs roughly
         70 MB of installed size. -->
    <SelfContained>true</SelfContained>

    <!-- Single-file is deliberately off. OpenCvSharp resolves its native
         OpenCV DLLs by file name from the application directory; inside a
         single-file bundle that lookup fails at runtime — face detection would
         throw on the user's machine instead of failing here at build time. -->
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Ahead-of-time compilation for a noticeably shorter cold start. Makes
         the build larger, not the runtime slower. -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Trimming would remove types that WPF and System.Text.Json only ever
         reach through reflection. Not worth the failure modes for ~30 MB. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- No symbols: they embed the build machine's source paths. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>

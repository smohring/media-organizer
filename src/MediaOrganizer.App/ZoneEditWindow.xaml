<Window x:Class="MediaOrganizer.App.ZoneEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="640" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <!-- Feste Höhe statt SizeToContent: Mit SizeToContent und MaxHeight
         schnitt WPF den Inhalt unten ab, sobald die Vorschlagsliste da war —
         die Knöpfe waren dann nicht mehr erreichbar. Jetzt sind sie unten
         verankert und der Rest scrollt. -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{DynamicResource S.Cancel}" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="{DynamicResource S.Btn.Save}" IsDefault="True" MinWidth="90"
                        Style="{DynamicResource AccentButtonStyle}"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{DynamicResource S.Zone.TitleNew}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,12"
                           Text="{DynamicResource S.Zone.Intro}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Zone.Name}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,10" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Zone.Kind}" />
                <ComboBox x:Name="KindBox" Margin="0,0,0,10" DisplayMemberPath="Label" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Zone.Radius}" />
                <TextBox x:Name="RadiusBox" MaxWidth="90" HorizontalAlignment="Left" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                           Text="{DynamicResource S.Zone.RadiusHint}" />

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="{DynamicResource S.Zone.Position}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                           Text="{DynamicResource S.Zone.PositionHint}" />

                <!-- The coordinates come BEFORE the suggestion list on purpose.
                     They used to sit below it, and with the list filled the
                     640 px window pushed them past the scroll edge: the fields
                     were there, and nobody found them. The list is the optional
                     shortcut, so it goes last. -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Zone.Latitude}" />
                        <TextBox x:Name="LatBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Zone.Longitude}" />
                        <TextBox x:Name="LonBox" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4"
                           Text="{DynamicResource S.Zone.SuggestionsLabel}" />

                <ListBox x:Name="SuggestionList" MaxHeight="190" Margin="0,0,0,10"
                         SelectionChanged="Suggestion_SelectionChanged"
                         Visibility="Collapsed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="NoSuggestionsText" Style="{StaticResource Caption}" Margin="0,0,0,10"
                           Visibility="Collapsed"
                           Text="{DynamicResource S.Zone.NoSuggestions}" />

                <!-- Shown until the search over all shots comes back. The
                     dialog opens at once; on a large collection the places
                     take a moment, and waiting for them froze the window. -->
                <TextBlock x:Name="SearchingText" Style="{StaticResource Caption}" Margin="0,0,0,10"
                           Text="{DynamicResource S.Zone.SearchingSuggestions}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

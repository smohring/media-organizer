<Window x:Class="MediaOrganizer.App.PersonEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Person.Title}"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Text="{DynamicResource S.Person.Title}" />
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" Margin="0,4,0,14" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Person.Name}" />
        <TextBox x:Name="NameBox" Margin="0,0,0,12" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Person.Relation}" />
        <TextBox x:Name="RelationBox" Margin="0,0,0,4" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                   Text="{DynamicResource S.Person.RelationHint}" />

        <Border BorderThickness="0,1,0,0" Padding="0,14,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Person.MergeLabel}" />
                <ComboBox x:Name="MergeBox" DisplayMemberPath="Name" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="{DynamicResource S.Person.MergeHint}" />
                <Button x:Name="MergeButton" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Content="{DynamicResource S.Person.MergeButton}" Click="Merge_Click" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{DynamicResource S.Cancel}" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="{DynamicResource S.Btn.Save}" IsDefault="True" MinWidth="100"
                    Style="{DynamicResource AccentButtonStyle}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
